# Copy to `.env` in the ARCH_scorer repo root (never commit `.env`).
#   cp .env.example .env
#
# Which keys you need:
#   api_baseline / api_only     → ALPHA_GENOME_API_KEY
#   install_fold1 / --extract-emb → KAGGLE_USERNAME + KAGGLE_KEY
#   emb_baseline with --emb only → neither

# --- AlphaGenome hosted API (https://deepmind.google.com/science/alphagenome) ---
ALPHA_GENOME_API_KEY=

# --- Kaggle (fold_1 weight download only) ---
# 1) Create token: https://www.kaggle.com/settings → API → Create New Token
# 2) Accept model terms: https://www.kaggle.com/models/google/alphagenome
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional paths after install scripts
# ARCH_FOLD1_CKPT=
# ARCH_FASTA=
# ANNOVAR_DIR=
